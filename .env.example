# ==============================================================================
# Chatwoot Environment Configuration Template
# Copy this file to .env before starting Docker Compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Rails Configuration
# ------------------------------------------------------------------------------
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Used to verify the integrity of signed cookies and sessions.
# Generate a secure 64-byte secret key using: openssl rand -hex 64
SECRET_KEY_BASE=4b8c9d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c

# The public URL where Chatwoot will be accessed
# For local development: http://localhost:3000
# For production: https://chatwoot.yourdomain.com
FRONTEND_URL=http://localhost:3000
PORT=3000

# Force SSL redirect (set to true in production with HTTPS)
FORCE_SSL=false

# Account registration policy:
# true: Open signup enabled
# false: Signups disabled (only admins can invite users)
# api_only: Signups only via API
ENABLE_ACCOUNT_SIGNUP=false

# Default system locale
DEFAULT_LOCALE=en

# ------------------------------------------------------------------------------
# Active Storage (File uploads, attachments, avatars)
# Options: local, s3, gcs, azure
# ------------------------------------------------------------------------------
ACTIVE_STORAGE_SERVICE=local

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_production
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=chatwoot_secure_password_replace_me

# Connection URI used by Rails and Sidekiq
DATABASE_URL=postgres://postgres:chatwoot_secure_password_replace_me@postgres:5432/chatwoot_production

# PostgreSQL query timeout in milliseconds (default: 14000)
STATEMENT_TIMEOUT=14000

# ------------------------------------------------------------------------------
# Redis Configuration (Job queue, caching, ActionCable WebSockets)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=chatwoot_redis_password_replace_me
REDIS_URL=redis://:chatwoot_redis_password_replace_me@redis:6379/1

# Set to "none" if connecting to managed Redis with TLS (e.g., rediss:// on Render/Upstash)
# REDIS_OPENSSL_VERIFY_MODE=none

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Optional for local testing, recommended for production)
# ------------------------------------------------------------------------------
# MAILER_SENDER_EMAIL=Chatwoot <noreply@yourdomain.com>
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your_smtp_password
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_DOMAIN=yourdomain.com
